{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beyondfog",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [{"pattern":"beyondfog.cc.cd","custom_domain":true}],
  "send_email": [{"name":"EMAIL","destination_address":"fogpurification@gmail.com","allowed_sender_addresses":["noreply@beyondfog.cc.cd"]}],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SERVICE",
        "class_name": "BeyondFogService"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BeyondFogService"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beyondfog",
      "database_id": "f2bb555f-83d0-4bb4-8ff8-d0b7a0995669",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://beyondfog.cc.cd",
    "OWNER_EMAIL": "fogpurification@gmail.com",
    "EMAIL_FROM": "noreply@beyondfog.cc.cd",
    "WEBDAV_ALLOWED_HOSTS": "dav.jianguoyun.com"
  },
  "observability": {
    "enabled": false
  }
}
